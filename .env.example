# Vercel frontend (required in Preview and Production)
NEXT_PUBLIC_BROWSER_SERVICE_HTTP=https://browser.example.com
NEXT_PUBLIC_BROWSER_SERVICE_WS=wss://browser.example.com
NEXT_PUBLIC_BROWSER_INITIAL_URL=https://example.com/

# External browser-service host
HOST=0.0.0.0
PORT=3001
BROWSER_SERVICE_ALLOWED_ORIGINS=https://clevers.example.com
NAVIGATION_BLOCKED_HOSTS=adult.example,pornhub.com,xvideos.com,xnxx.com,redtube.com,youporn.com

# Development/test only. Do not enable these in production.
BROWSER_TEST_TARGET_URL=http://127.0.0.1:3002
ENABLE_LOCAL_TEST_TARGET=false
NAVIGATION_DIAGNOSTICS=false
