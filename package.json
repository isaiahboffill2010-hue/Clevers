{
  "name": "remote-browser-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@remote-browser/web --filter=@remote-browser/browser-service --filter=@remote-browser/test-site",
    "dev:web": "pnpm --filter @remote-browser/web dev",
    "dev:browser-service": "pnpm --filter @remote-browser/browser-service dev",
    "dev:test-site": "pnpm --filter @remote-browser/test-site dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @remote-browser/browser-service test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
